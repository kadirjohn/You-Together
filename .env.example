# Development mode
NODE_ENV=development
PORT=3000
# Docker Compose dev: redis://localhost:6380
# Docker Compose prod: redis://redis:6379
REDIS_URL=redis://localhost:6380
PUBLIC_BASE_URL=http://localhost:3000
ROOM_MAX_USERS=10
ROOM_ACTIVE_TTL_SECONDS=10800
ROOM_EMPTY_TTL_SECONDS=300
CHAT_MAX_MESSAGES=100
PIN_MIN_LENGTH=4
PIN_MAX_LENGTH=12

# --- YouTube metadata (video duration / title / channel) ---
# Opsiyonel. Sağlanırsa video süreleri/titel/kanal tam ve doğru gelir (YouTube Data API v3).
# Sağlanmazsa oEmbed ile title/kanal gelir, süre istemci fallback ile çalışır ("120 dk" gider).
# Console'dan: https://console.cloud.google.com/ -> YouTube Data API v3 etkinleştir -> API key oluştur
YOUTUBE_API_KEY=
# YouTube video metadata cache süresi (saniye). Varsayılan 7 gün.
YOUTUBE_CACHE_TTL_SECONDS=604800
# Per-oda izlenen videolar listesi üst sınırı
WATCHLIST_MAX_VIDEOS=50

# --- Frontend ---
# VITE_SOCKET_URL=http://localhost:3000
