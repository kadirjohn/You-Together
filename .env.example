# ─── Environment değişkenleri şablonu ──────────────────────────────
# Kullanım: cp .env.example .env  →  değerleri kendi kurulumuna göre doldur.

# Çalışma modu: development | production
NODE_ENV=development
PORT=3000

# Redis bağlantısı
#   Docker Compose (dev & prod): redis://redis:6379
#   Native (Docker'suz) dev:      redis://localhost:6379
REDIS_URL=redis://redis:6379

# ⚠️ Paylaşılan oda linkleri bu URL'den üretilir (${PUBLIC_BASE_URL}/room/<id>).
# Üretimde mutlaka gerçek public URL olmalı — localhost bırakılırsa linkler bozulur.
# Örnek: https://you.kadirca.com
PUBLIC_BASE_URL=http://localhost:3000

# CORS — frontend origin'leri (virgülle ayır).
# Aynı domain (proxy arkasında) tek değer yeterli. Birden fazla: https://a.com,https://b.com
# Boş bırakılırsa varsayılan: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Oda yönetimi
ROOM_MAX_USERS=10
ROOM_ACTIVE_TTL_SECONDS=10800
ROOM_EMPTY_TTL_SECONDS=300
CHAT_MAX_MESSAGES=100
PIN_MIN_LENGTH=4
PIN_MAX_LENGTH=12

# --- YouTube metadata (video duration / title / channel) ---
# Opsiyonel. Sağlanırsa video süreleri/title/kanal tam ve doğru gelir (YouTube Data API v3).
# Sağlanmazsa oEmbed ile title/kanal gelir, süre istemci fallback ile çalışır.
# Console'dan: https://console.cloud.google.com/ -> YouTube Data API v3 etkinleştir -> API key oluştur
YOUTUBE_API_KEY=
# YouTube video metadata cache süresi (saniye). Varsayılan 7 gün.
YOUTUBE_CACHE_TTL_SECONDS=604800
# Per-oda izlenen videolar listesi üst sınırı
WATCHLIST_MAX_VIDEOS=50

# --- Frontend (client build anında gömülür, runtime'da değil) ---
# BOŞ bırak → socket.io aynı origin üzerinden bağlanır (üretim için doğru).
# Yalnızca frontend farklı host'ta serve edilirse doldur.
# VITE_SOCKET_URL=http://localhost:3000
